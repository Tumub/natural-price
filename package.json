{
  "name": "natural-price",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/extension/tsconfig.json --noEmit && tsc -p packages/fetch-service/tsconfig.json --noEmit",
    "demo": "tsx packages/extension/src/cli.ts",
    "add-fixture": "tsx packages/extension/src/tools/add-fixture.ts",
    "build:extension": "node packages/extension/build.mjs",
    "service": "tsx packages/fetch-service/src/index.ts",
    "test:unit": "vitest run --exclude '**/*.e2e.test.ts'",
    "live-check": "tsx packages/fetch-service/scripts/live-check.ts",
    "screenshots": "tsx packages/extension/scripts/screenshot.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
