{
  "manifest_version": 3,
  "name": "Natural Price",
  "version": "0.4.0",
  "description": "Shows the price a stranger would get next to the price you were shown.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["__SERVICE_ORIGIN__/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.ikea.com/*", "https://www.mediamarkt.ch/*", "https://www.nike.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
